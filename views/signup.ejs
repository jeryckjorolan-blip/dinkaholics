<%- include('partials/header') %>

<div class="min-h-[80vh] flex items-center justify-center">
  <div class="bg-navy-800 rounded-2xl shadow-2xl p-8 w-full max-w-md border border-navy-600">
    <div class="text-center mb-8">
      <div class="w-20 h-20 mx-auto rounded-full bg-navy-900 border-2 border-brand-400/50 flex items-center justify-center mb-4">
        <span class="text-3xl font-bold text-brand-400">D</span>
      </div>
      <h1 class="text-3xl font-bold text-brand-400 tracking-wide">Join Dinkaholics</h1>
      <p class="text-stone-400 mt-2 text-sm">Request an account · Admin must approve</p>
    </div>

    <% if (error) { %>
      <div class="bg-red-900/50 border border-red-700 text-red-200 px-4 py-3 rounded-lg mb-6 text-sm">
        <%= error %>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="bg-green-900/40 border border-green-700 text-green-200 px-4 py-3 rounded-lg mb-6 text-sm">
        <%= success %>
      </div>
      <a href="/login" class="block w-full text-center bg-brand-500 hover:bg-brand-400 text-navy-900 font-bold py-3 rounded-lg transition">
        Back to Login
      </a>
    <% } else { %>
      <form method="POST" action="/signup" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-stone-300 mb-1">Display Name</label>
          <input type="text" name="display_name" required autofocus
            class="w-full bg-navy-900 border border-navy-600 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent"
            placeholder="Your name (shown on leaderboard)">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-300 mb-1">Username</label>
          <input type="text" name="username" required minlength="3"
            class="w-full bg-navy-900 border border-navy-600 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent"
            placeholder="Login username">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-300 mb-1">Password</label>
          <input type="password" name="password" required minlength="4"
            class="w-full bg-navy-900 border border-navy-600 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent"
            placeholder="At least 4 characters">
        </div>
        <button type="submit"
          class="w-full bg-brand-500 hover:bg-brand-400 text-navy-900 font-bold py-3 rounded-lg transition">
          Request Account
        </button>
      </form>
      <p class="text-center text-stone-500 text-sm mt-6">
        Already have an account?
        <a href="/login" class="text-brand-400 hover:text-brand-300">Sign in</a>
      </p>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
