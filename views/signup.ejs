<%- include('partials/header') %>

<div class="min-h-[calc(100vh-80px)] flex items-center justify-center px-4 py-12 hero-bg">
  <div class="bg-navy-850/95 border border-navy-600/60 rounded-2xl shadow-2xl p-8 w-full max-w-md backdrop-blur">
    <div class="text-center mb-8">
      <img src="<%= typeof clubLogo !== 'undefined' && clubLogo ? clubLogo : '/img/logo.svg' %>" alt="Dinkaholics"
        class="w-20 h-20 mx-auto rounded-full object-cover ring-2 ring-brand-400/60 mb-4 shadow-lg shadow-brand-500/20 bg-navy-900"
        onerror="this.onerror=null; this.src='/img/logo.jpg';">
      <% if (success === 'REQUEST_RECEIVED') { %>
        <h1 class="text-2xl font-bold text-white mb-2">REQUEST RECEIVED! 🎉</h1>
        <p class="text-stone-300 text-sm leading-relaxed">
          Your account is waiting for admin approval.<br>
          We’ll see you on the court.
        </p>
        <p class="text-stone-500 text-xs mt-4">Tell the group chat you signed up so an admin can approve you faster.</p>
        <a href="/login" class="inline-block mt-6 text-brand-400 hover:text-brand-300 font-semibold text-sm">Back to login →</a>
      <% } else { %>
        <h1 class="text-2xl font-bold tracking-wide text-white">JOIN THE DINK. 🏓</h1>
        <p class="text-stone-400 mt-2 text-sm">Become part of the Dinkaholics community.</p>
        <p class="text-brand-400/80 text-xs mt-2 font-semibold tracking-[0.15em]">PLAY · CONNECT · REPEAT</p>
      <% } %>
    </div>

    <% if (!success) { %>
      <% if (error) { %>
        <div class="bg-red-900/40 border border-red-700/50 text-red-200 px-4 py-3 rounded-lg mb-6 text-sm"><%= error %></div>
      <% } %>

      <form method="POST" action="/signup" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-stone-300 mb-1.5">Display Name</label>
          <input type="text" name="display_name" required
            class="w-full bg-navy-900 border border-navy-600 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-400 text-stone-100"
            placeholder="How you appear on the rankings">
          <p class="text-xs text-stone-600 mt-1">Your name on leaderboards and match results.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-300 mb-1.5">Username</label>
          <input type="text" name="username" required minlength="3"
            class="w-full bg-navy-900 border border-navy-600 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-400 text-stone-100"
            placeholder="login name">
          <p class="text-xs text-stone-600 mt-1">Used only to sign in. Min 3 characters.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-300 mb-1.5">Password</label>
          <input type="password" name="password" required minlength="4"
            class="w-full bg-navy-900 border border-navy-600 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-400 text-stone-100"
            placeholder="At least 4 characters">
          <p class="text-xs text-stone-600 mt-1">Keep it private. You’ll need it every time you log in.</p>
        </div>
        <button type="submit" class="w-full bg-brand-500 hover:bg-brand-400 text-navy-900 font-bold py-3 rounded-xl transition shadow-lg shadow-brand-500/20">
          Request Account
        </button>
      </form>
      <p class="text-center text-stone-400 text-sm mt-6">
        Already have an account? <a href="/login" class="text-brand-400 hover:text-brand-300 font-medium">Sign in</a>
      </p>
      <p class="text-center text-stone-600 text-xs mt-3">An admin must approve new members before you can log in.</p>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
