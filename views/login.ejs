<%- include('partials/header') %>

<div class="min-h-[calc(100vh-80px)] flex items-center justify-center px-4 py-12 hero-bg">
  <div class="bg-navy-850/95 border border-navy-600/60 rounded-2xl shadow-2xl p-8 w-full max-w-md backdrop-blur">
    <div class="text-center mb-8">
      <img src="<%= typeof clubLogo !== 'undefined' && clubLogo ? clubLogo : '/img/logo.svg' %>" alt="Dinkaholics"
        class="w-20 h-20 mx-auto rounded-full object-cover ring-2 ring-brand-400/60 mb-4 shadow-lg shadow-brand-500/20 bg-navy-900"
        onerror="this.onerror=null; this.src='/img/logo.jpg';">
      <h1 class="text-2xl font-bold tracking-wide">
        <span class="text-white">DINK</span><span class="text-brand-400">A</span><span class="text-white">HOLICS</span>
      </h1>
      <p class="text-brand-400/80 text-xs mt-1 font-semibold tracking-[0.15em]">PLAY · CONNECT · REPEAT</p>
      <p class="text-stone-400 mt-3 text-sm">Club Members Only</p>
    </div>

    <% if (error) { %>
      <div class="bg-red-900/40 border border-red-700/50 text-red-200 px-4 py-3 rounded-lg mb-6 text-sm">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/login" class="space-y-5" autocomplete="on">
      <div>
        <label class="block text-sm font-medium text-stone-300 mb-1.5">Username</label>
        <input type="text" name="username" required autofocus autocomplete="username"
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent text-stone-100"
          placeholder="Enter username">
      </div>
      <div>
        <label class="block text-sm font-medium text-stone-300 mb-1.5">Password</label>
        <input type="password" name="password" required autocomplete="current-password"
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent text-stone-100"
          placeholder="Enter password">
      </div>
      <label class="flex items-center gap-2 text-sm text-stone-300 cursor-pointer select-none">
        <input type="checkbox" name="rememberMe" value="on"
          class="rounded border-navy-500 text-brand-500 focus:ring-brand-400 bg-navy-900">
        Remember me (stay logged in)
      </label>
      <button type="submit"
        class="w-full bg-brand-500 hover:bg-brand-400 text-navy-900 font-bold py-3 rounded-lg transition shadow-lg shadow-brand-500/20">
        Sign In
      </button>
    </form>

    <p class="text-center text-stone-400 text-sm mt-6">
      New here?
      <a href="/signup" class="text-brand-400 hover:text-brand-300 font-medium">Request an account</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
