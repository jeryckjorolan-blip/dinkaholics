<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Dinkaholics</title>
  <link rel="icon" type="image/jpeg" href="/img/logo.jpg">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50:  '#f4fce8',
              100: '#e6f8c5',
              200: '#cef08f',
              300: '#b4e645',
              400: '#9ad42a',
              500: '#7fb81a',
              600: '#629212',
              700: '#4a6f12',
              800: '#3d5914',
              900: '#344b15',
            },
            navy: {
              950: '#060d18',
              900: '#0a1628',
              850: '#0c1c30',
              800: '#0f2035',
              750: '#132840',
              700: '#16304a',
              600: '#1e3f5c',
              500: '#2a5478',
            }
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }
    .hero-bg {
      background-image:
        linear-gradient(105deg, rgba(10,22,40,0.92) 0%, rgba(10,22,40,0.78) 40%, rgba(10,22,40,0.55) 100%),
        url('https://images.unsplash.com/photo-1554068865-24cecd4e34b8?auto=format&fit=crop&w=1600&q=80');
      background-size: cover;
      background-position: center right;
    }
    .nav-link { position: relative; padding-bottom: 2px; }
    .nav-link.active::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: -10px;
      height: 3px;
      background: #9ad42a;
      border-radius: 2px;
    }
    .table-row:hover { background: rgba(154, 212, 42, 0.04); }
  </style>
</head>
<body class="bg-navy-900 text-stone-100 min-h-screen flex flex-col">
  <% if (currentUser) { %>
  <nav class="bg-navy-950/95 border-b border-navy-700/60 sticky top-0 z-50 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <img src="/img/logo.jpg" alt="Dinkaholics" class="h-10 w-10 rounded-full object-cover ring-2 ring-brand-400/70 group-hover:ring-brand-300 transition shadow-lg shadow-brand-500/10">
        <span class="text-xl font-bold tracking-wide hidden sm:inline">
          <span class="text-white">DINK</span><span class="text-brand-400">A</span><span class="text-white">HOLICS</span>
        </span>
      </a>
      <div class="flex items-center gap-1 sm:gap-6 text-sm font-medium">
        <a href="/" class="nav-link px-2 py-1 transition <%= title === 'Leaderboard' ? 'text-brand-400 active' : 'text-stone-300 hover:text-brand-400' %>">Leaderboard</a>
        <a href="/live" class="nav-link px-2 py-1 transition <%= title === 'Live Scoring' ? 'text-brand-400 active' : 'text-stone-300 hover:text-brand-400' %>">Live Scoring</a>
        <a href="/history" class="nav-link px-2 py-1 transition <%= title === 'Game History' ? 'text-brand-400 active' : 'text-stone-300 hover:text-brand-400' %>">History</a>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin" class="nav-link px-2 py-1 transition <%= title === 'Admin Panel' ? 'text-brand-400 active' : 'text-stone-300 hover:text-brand-400' %>">Admin</a>
        <% } %>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-stone-400 text-xs hidden md:inline max-w-[120px] truncate"><%= currentUser.display_name %></span>
        <form action="/logout" method="POST" class="inline">
          <button type="submit" title="Logout" class="w-9 h-9 rounded-full bg-navy-800 border border-navy-600 flex items-center justify-center text-stone-400 hover:text-brand-400 hover:border-brand-500/50 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </button>
        </form>
      </div>
    </div>
  </nav>
  <% } %>
  <main class="flex-1 w-full">
