<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Dinkaholics</title>
  <link rel="icon" type="image/jpeg" href="/img/logo.jpg">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50:  '#f4fce8',
              100: '#e6f8c5',
              200: '#cef08f',
              300: '#b4e645',
              400: '#9ad42a',
              500: '#7fb81a',
              600: '#629212',
              700: '#4a6f12',
              800: '#3d5914',
              900: '#344b15',
            },
            navy: {
              900: '#0a1628',
              850: '#0c1c30',
              800: '#0f2035',
              750: '#132840',
              700: '#16304a',
              600: '#1e3f5c',
              500: '#2a5478',
            }
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Segoe UI', system-ui, sans-serif; }
    .trophy { filter: drop-shadow(0 0 4px gold); }
  </style>
</head>
<body class="bg-navy-900 text-stone-100 min-h-screen">
  <% if (currentUser) { %>
  <nav class="bg-navy-800 border-b border-navy-600 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-3">
      <a href="/" class="flex items-center gap-2.5 group">
        <img src="/img/logo.jpg" alt="Dinkaholics" class="h-10 w-10 rounded-full object-cover ring-2 ring-brand-400/60 group-hover:ring-brand-300 transition">
        <span class="text-xl font-bold text-brand-400 tracking-wide">Dinkaholics</span>
      </a>
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <a href="/" class="hover:text-brand-400 transition">Leaderboard</a>
        <a href="/live" class="hover:text-brand-400 transition">Live Scoring</a>
        <a href="/history" class="hover:text-brand-400 transition">History</a>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin" class="text-brand-300 hover:text-brand-400 font-semibold">Admin</a>
        <% } %>
        <span class="text-navy-500">|</span>
        <span class="text-stone-300"><%= currentUser.display_name %></span>
        <form action="/logout" method="POST" class="inline">
          <button type="submit" class="text-stone-400 hover:text-red-400 text-xs">Logout</button>
        </form>
      </div>
    </div>
  </nav>
  <% } %>
  <main class="max-w-6xl mx-auto px-4 py-6">
