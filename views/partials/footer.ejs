</main>
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <!-- Mobile bottom navigation — links match current live routes -->
  <nav class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-navy-950/98 border-t border-navy-700/80 backdrop-blur-lg" style="padding-bottom: max(0.5rem, env(safe-area-inset-bottom));">
    <div class="flex items-stretch justify-around px-1 pt-2 text-[10px] font-medium text-stone-500">
      <a href="/" class="flex flex-col items-center gap-0.5 py-1 min-w-[3.25rem] <%= title === 'Leaderboard' ? 'text-brand-400' : '' %>">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>
        <span>Home</span>
      </a>
      <a href="/live" class="flex flex-col items-center gap-0.5 py-1 min-w-[3.25rem] <%= title === 'Live Scoring' ? 'text-brand-400' : '' %>">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z"/></svg>
        <span>Live</span>
      </a>
      <a href="/wta" class="flex flex-col items-center gap-0.5 py-1 min-w-[3.25rem] <%= title === 'WTA Games' ? 'text-brand-400' : '' %>">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
        <span>WTA</span>
      </a>
      <a href="/history" class="flex flex-col items-center gap-0.5 py-1 min-w-[3.25rem] <%= title === 'Game History' ? 'text-brand-400' : '' %>">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span>History</span>
      </a>
      <a href="<%= typeof myPlayerId !== 'undefined' && myPlayerId ? '/player/' + myPlayerId : '/' %>" class="flex flex-col items-center gap-0.5 py-1 min-w-[3.25rem]">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
        <span>Profile</span>
      </a>
    </div>
  </nav>
  <style>
    @media (max-width: 767px) {
      main { padding-bottom: 5.5rem !important; }
    }
  </style>
  <% } %>
  <footer class="mt-auto border-t border-navy-700/60 bg-navy-950 <%= typeof currentUser !== 'undefined' && currentUser ? 'hidden md:block' : '' %>">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <img src="<%= typeof clubLogo !== 'undefined' && clubLogo ? clubLogo : '/img/logo.svg' %>" onerror="this.onerror=null;this.src='/img/logo.jpg'" alt="" class="h-9 w-9 rounded-full object-cover ring-1 ring-brand-400/40">
        <div>
          <span class="font-bold tracking-wide text-sm">
            <span class="text-white">DINK</span><span class="text-brand-400">A</span><span class="text-white">HOLICS</span>
          </span>
          <p class="text-stone-500 text-xs mt-0.5">PLAY · CONNECT · REPEAT</p>
        </div>
      </div>
      <p class="text-xs text-stone-600">Pickleball community platform</p>
    </div>
  </footer>
</body>
</html>
