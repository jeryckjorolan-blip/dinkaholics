<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white">Tournaments</h1>
      <p class="text-stone-500 text-sm mt-1">Brackets, finals, champions</p>
    </div>
  </div>

  <% if (msg) { %>
  <div class="bg-green-900/40 border border-green-700/50 text-green-200 px-4 py-3 rounded-xl mb-6 text-sm"><%= String(msg).replace(/\+/g, ' ') %></div>
  <% } %>
  <% if (error) { %>
  <div class="bg-red-900/40 border border-red-700/50 text-red-200 px-4 py-3 rounded-xl mb-6 text-sm"><%= String(error).replace(/\+/g, ' ') %></div>
  <% } %>

  <% if (currentUser.role === 'admin') { %>
  <section class="bg-navy-850 border border-navy-600/50 rounded-2xl p-5 mb-8">
    <h2 class="text-sm font-semibold text-brand-400 uppercase tracking-wider mb-4">Create Tournament</h2>
    <form method="POST" action="/tournaments" class="grid sm:grid-cols-4 gap-3 items-end">
      <div class="sm:col-span-2">
        <label class="block text-xs text-stone-400 mb-1">Name</label>
        <input type="text" name="name" required placeholder="Dinkaholics Open #01"
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-3 py-2.5 text-stone-100 focus:outline-none focus:ring-2 focus:ring-brand-400">
      </div>
      <div>
        <label class="block text-xs text-stone-400 mb-1">Max players</label>
        <input type="number" name="max_players" value="16" min="4" max="32"
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-3 py-2.5 text-stone-100 focus:outline-none focus:ring-2 focus:ring-brand-400">
      </div>
      <button type="submit" class="bg-brand-500 hover:bg-brand-400 text-navy-900 font-bold py-2.5 rounded-lg transition">Create</button>
    </form>
  </section>
  <% } %>

  <% if (!tournaments || tournaments.length === 0) { %>
    <div class="bg-navy-850 border border-navy-600/40 rounded-2xl p-12 text-center text-stone-500">
      <p class="text-lg mb-1">No tournaments yet</p>
      <p class="text-sm">Admins can create the first Dinkaholics Open above.</p>
    </div>
  <% } else { %>
    <div class="grid sm:grid-cols-2 gap-4">
      <% tournaments.forEach(t => { %>
      <a href="/tournaments/<%= t.id %>" class="bg-navy-850 border border-navy-600/50 rounded-2xl p-5 card-hover block">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="font-bold text-lg text-white"><%= t.name %></h3>
            <p class="text-xs text-stone-500 mt-1"><%= t.player_count || 0 %> / <%= t.max_players %> players</p>
          </div>
          <span class="text-[10px] uppercase font-semibold tracking-wider px-2 py-1 rounded-md
            <%= t.status === 'completed' ? 'bg-brand-500/15 text-brand-400' : t.status === 'active' ? 'bg-amber-500/15 text-amber-400' : 'bg-navy-700 text-stone-400' %>">
            <%= t.status %>
          </span>
        </div>
      </a>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
