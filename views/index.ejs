<%- include('partials/header') %>

<div class="mb-8">
  <h1 class="text-3xl font-bold text-brand-400">Leaderboard</h1>
  <p class="text-stone-400 mt-1">Winners Take All · Ranked by wins, then total score</p>
</div>

<% if (liveGames && liveGames.length > 0) { %>
<div class="mb-8 bg-amber-900/30 border border-amber-700/50 rounded-xl p-4">
  <h2 class="text-lg font-semibold text-amber-300 mb-2 flex items-center gap-2">
    <span class="animate-pulse">●</span> Live Games in Progress
  </h2>
  <div class="flex flex-wrap gap-3">
    <% liveGames.forEach(g => { %>
      <a href="/live" class="bg-navy-800 hover:bg-navy-700 px-4 py-2 rounded-lg text-sm border border-navy-600 transition">
        <%= g.title || 'Live Game' %> · <%= g.player_count %> players
      </a>
    <% }) %>
  </div>
</div>
<% } %>

<% if (typeof openGames !== 'undefined' && openGames && openGames.length > 0) { %>
<div class="mb-8 bg-brand-900/20 border border-brand-700/40 rounded-xl p-4">
  <h2 class="text-lg font-semibold text-brand-300 mb-2">Open WTA Games — Join Now!</h2>
  <div class="flex flex-wrap gap-3">
    <% openGames.forEach(g => { %>
      <a href="/live" class="bg-navy-800 hover:bg-navy-700 px-4 py-2 rounded-lg text-sm border border-brand-600/50 transition flex items-center gap-2">
        <span class="text-brand-400 font-medium"><%= g.title || 'WTA Game' %></span>
        <span class="text-stone-400">· <%= g.player_count || 0 %> joined</span>
      </a>
    <% }) %>
  </div>
</div>
<% } %>

<!-- Leaderboard Table -->
<div class="bg-navy-800 rounded-xl border border-navy-600 overflow-hidden mb-10">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead class="bg-navy-750 text-stone-400 text-xs uppercase tracking-wider">
        <tr>
          <th class="px-4 py-3">#</th>
          <th class="px-4 py-3">Player</th>
          <th class="px-4 py-3 text-center">Wins</th>
          <th class="px-4 py-3 text-center">Games</th>
          <th class="px-4 py-3 text-center">Win %</th>
          <th class="px-4 py-3 text-center">Total Score</th>
          <th class="px-4 py-3 text-center">Avg Score</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-navy-600">
        <% if (leaderboard.length === 0) { %>
          <tr>
            <td colspan="7" class="px-4 py-8 text-center text-stone-500">No games recorded yet. Start tracking!</td>
          </tr>
        <% } %>
        <% leaderboard.forEach((p, i) => { %>
          <tr class="hover:bg-navy-750/50 transition <%= i === 0 && p.wins > 0 ? 'bg-amber-900/20' : '' %>">
            <td class="px-4 py-3 font-mono text-stone-400">
              <% if (i === 0 && p.wins > 0) { %><span class="text-2xl">🥇</span>
              <% } else if (i === 1 && p.wins > 0) { %><span class="text-xl">🥈</span>
              <% } else if (i === 2 && p.wins > 0) { %><span class="text-xl">🥉</span>
              <% } else { %><%= i + 1 %><% } %>
            </td>
            <td class="px-4 py-3">
              <a href="/player/<%= p.id %>" class="font-semibold text-brand-300 hover:text-brand-400 transition">
                <%= p.name %>
              </a>
            </td>
            <td class="px-4 py-3 text-center font-bold text-brand-400"><%= p.wins %></td>
            <td class="px-4 py-3 text-center text-stone-300"><%= p.games_played %></td>
            <td class="px-4 py-3 text-center">
              <span class="<%= p.win_rate >= 50 ? 'text-green-400' : 'text-stone-400' %>"><%= p.win_rate %>%</span>
            </td>
            <td class="px-4 py-3 text-center text-stone-200"><%= p.total_score %></td>
            <td class="px-4 py-3 text-center text-stone-400"><%= Number(p.avg_score).toFixed(1) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Recent Games -->
<div>
  <h2 class="text-xl font-semibold mb-4 text-stone-200">Recent Games</h2>
  <% if (recentGames.length === 0) { %>
    <p class="text-stone-500">No games yet.</p>
  <% } else { %>
    <div class="grid gap-3 sm:grid-cols-2">
      <% recentGames.forEach(g => { %>
        <div class="bg-navy-800 border border-navy-600 rounded-lg p-4">
          <div class="flex justify-between items-start mb-2">
            <h3 class="font-medium text-brand-300"><%= g.title || 'Game #' + g.id %></h3>
            <span class="text-xs text-stone-500"><%= new Date(g.game_date).toLocaleDateString() %></span>
          </div>
          <p class="text-sm text-stone-400"><%= g.participants || 'No scores' %></p>
          <% if (g.notes) { %><p class="text-xs text-stone-500 mt-1 italic"><%= g.notes %></p><% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
