<%- include('partials/header') %>

<!-- Hero -->
<section class="hero-bg relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 md:py-20">
    <p class="text-brand-400 text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase mb-3">Pickleball Community</p>
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-none mb-3">
      LEADERBOARD
    </h1>
    <p class="text-stone-300 text-sm sm:text-base max-w-md mb-4">
      Winners Take All · Ranked by wins, then total score
    </p>
    <div class="w-12 h-1 bg-brand-400 rounded-full"></div>
  </div>
</section>

<div class="max-w-6xl mx-auto px-4 sm:px-6 -mt-4 sm:-mt-6 relative z-10 pb-12">

  <% if (liveGames && liveGames.length > 0) { %>
  <div class="mb-5 bg-amber-950/50 border border-amber-600/30 rounded-xl p-4 backdrop-blur">
    <div class="flex items-center gap-2 mb-3">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-400"></span>
      </span>
      <h2 class="text-xs font-semibold text-amber-300 uppercase tracking-wider">Live Now</h2>
    </div>
    <div class="flex flex-wrap gap-2">
      <% liveGames.forEach(g => { %>
        <a href="/live" class="bg-navy-800/80 hover:bg-navy-700 px-4 py-2 rounded-lg text-sm border border-navy-600 transition">
          <%= g.title || 'Live Game' %> · <%= g.player_count %> players
        </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <% if (typeof openGames !== 'undefined' && openGames && openGames.length > 0) { %>
  <div class="mb-5 bg-brand-900/20 border border-brand-600/25 rounded-xl p-4">
    <h2 class="text-xs font-semibold text-brand-300 uppercase tracking-wider mb-3">Open Games — Join</h2>
    <div class="flex flex-wrap gap-2">
      <% openGames.forEach(g => { %>
        <a href="/live" class="bg-navy-800/80 hover:bg-navy-700 px-4 py-2 rounded-lg text-sm border border-brand-600/30 transition flex items-center gap-2">
          <span class="text-brand-400 font-medium"><%= g.title || 'WTA Game' %></span>
          <span class="text-stone-500 text-xs"><%= g.player_count || 0 %> joined</span>
        </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Leaderboard table -->
  <div class="bg-navy-850/90 rounded-2xl border border-navy-600/50 overflow-hidden shadow-2xl shadow-black/30 mb-10">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-navy-600/60 text-stone-500 text-[11px] uppercase tracking-wider bg-navy-900/40">
            <th class="px-4 sm:px-5 py-3.5 font-medium w-12">#</th>
            <th class="px-4 sm:px-5 py-3.5 font-medium">Player</th>
            <th class="px-4 sm:px-5 py-3.5 font-medium text-center">Wins</th>
            <th class="px-4 sm:px-5 py-3.5 font-medium text-center hidden sm:table-cell">Games</th>
            <th class="px-4 sm:px-5 py-3.5 font-medium text-center">Win %</th>
            <th class="px-4 sm:px-5 py-3.5 font-medium text-center hidden md:table-cell">Total Score</th>
            <th class="px-4 sm:px-5 py-3.5 font-medium text-center hidden md:table-cell">Avg Score</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-navy-700/50">
          <% if (!leaderboard || leaderboard.length === 0) { %>
            <tr>
              <td colspan="7" class="px-5 py-16 text-center text-stone-500">
                <p class="text-base mb-1">No players yet</p>
                <p class="text-sm text-stone-600">Members appear here after an admin approves their signup and they play games.</p>
              </td>
            </tr>
          <% } else { %>
            <% leaderboard.forEach((p, i) => { %>
              <tr class="table-row transition">
                <td class="px-4 sm:px-5 py-3.5 text-stone-500 font-mono text-sm"><%= i + 1 %></td>
                <td class="px-4 sm:px-5 py-3.5">
                  <a href="/player/<%= p.id %>" class="font-semibold text-brand-400 hover:text-brand-300 transition">
                    <%= p.name %>
                  </a>
                </td>
                <td class="px-4 sm:px-5 py-3.5 text-center font-bold text-brand-400"><%= p.wins %></td>
                <td class="px-4 sm:px-5 py-3.5 text-center text-stone-400 hidden sm:table-cell"><%= p.games_played %></td>
                <td class="px-4 sm:px-5 py-3.5 text-center text-stone-300"><%= p.win_rate %>%</td>
                <td class="px-4 sm:px-5 py-3.5 text-center text-stone-400 hidden md:table-cell"><%= p.total_score %></td>
                <td class="px-4 sm:px-5 py-3.5 text-center text-stone-400 hidden md:table-cell"><%= Number(p.avg_score || 0).toFixed(1) %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recent Games -->
  <div class="mb-4">
    <h2 class="text-lg font-bold text-white tracking-wide mb-1">RECENT GAMES</h2>
    <div class="w-10 h-0.5 bg-brand-400 rounded-full mb-5"></div>
  </div>

  <% if (!recentGames || recentGames.length === 0) { %>
    <div class="bg-navy-850/60 border border-navy-700/40 rounded-xl px-5 py-8 text-center text-stone-500">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto mb-2 text-stone-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
      </svg>
      <p>No games yet.</p>
    </div>
  <% } else { %>
    <div class="space-y-3">
      <% recentGames.forEach(g => { %>
        <div class="bg-navy-850/70 border border-navy-700/40 rounded-xl px-5 py-4 flex flex-wrap justify-between items-start gap-3">
          <div>
            <h3 class="font-semibold text-stone-100"><%= g.title || 'WTA Game #' + g.id %></h3>
            <p class="text-xs text-stone-500 mt-1"><%= g.participants || 'No scores' %></p>
          </div>
          <span class="text-xs text-stone-500 whitespace-nowrap"><%= g.game_date ? new Date(g.game_date).toLocaleDateString() : '' %></span>
        </div>
      <% }) %>
    </div>
  <% } %>

</div>

<%- include('partials/footer') %>
