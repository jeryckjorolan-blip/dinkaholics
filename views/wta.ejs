<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
  <div class="flex flex-wrap items-start justify-between gap-4 mb-8">
    <div>
      <p class="text-brand-400 text-xs font-semibold tracking-[0.2em] uppercase mb-1">Winners Take All</p>
      <h1 class="text-3xl sm:text-4xl font-black text-white">Posted Games</h1>
      <p class="text-stone-400 text-sm mt-1">Join open WTA events · Teams of 2 after shuffle</p>
      <div class="w-12 h-1 bg-brand-400 rounded-full mt-3"></div>
    </div>
    <% if (currentUser && currentUser.role === 'admin') { %>
      <button onclick="document.getElementById('post-game-form').classList.toggle('hidden')"
        class="bg-brand-500 hover:bg-brand-400 text-navy-900 text-sm font-bold px-5 py-2.5 rounded-lg transition shadow-lg shadow-brand-500/20">
        + Post New WTA Game
      </button>
    <% } %>
  </div>

  <% if (msg) { %>
    <div class="bg-green-900/40 border border-green-700 text-green-200 px-4 py-3 rounded-lg mb-6 text-sm"><%= String(msg).replace(/\+/g, ' ') %></div>
  <% } %>
  <% if (error) { %>
    <div class="bg-red-900/40 border border-red-700 text-red-200 px-4 py-3 rounded-lg mb-6 text-sm"><%= String(error).replace(/\+/g, ' ') %></div>
  <% } %>

  <% if (currentUser && currentUser.role === 'admin') { %>
  <div id="post-game-form" class="hidden bg-navy-800 border border-brand-700/40 rounded-xl p-6 mb-8">
    <h3 class="font-semibold text-brand-300 mb-4 text-lg">Post a WTA Game</h3>
    <form method="POST" action="/games/open" class="grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label class="block text-xs text-stone-400 mb-1">Game Title *</label>
        <input type="text" name="title" placeholder="e.g. Friday Night WTA" required
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-xs text-stone-400 mb-1">Location</label>
        <input type="text" name="location" placeholder="Court / venue name"
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-xs text-stone-400 mb-1">Date</label>
        <input type="date" name="event_date"
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-xs text-stone-400 mb-1">Time</label>
        <input type="time" name="event_time"
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-xs text-stone-400 mb-1">Max # of Players</label>
        <input type="number" name="max_players" min="2" max="64" placeholder="e.g. 16"
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-xs text-stone-400 mb-1">Entry Fee / Price</label>
        <input type="text" name="entry_fee" placeholder="e.g. 200 or Free"
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-xs text-stone-400 mb-1">Cash Prize</label>
        <input type="text" name="cash_prize" placeholder="e.g. 2000 winner takes all"
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-xs text-stone-400 mb-1"># of Winners / Places Paid</label>
        <select name="winner_slots" class="w-full bg-navy-900 border border-navy-600 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="1">1 — Champion only</option>
          <option value="2" selected>2 — Champion + 1st place</option>
          <option value="3">3 — Champion, 1st, 2nd</option>
          <option value="4">4 places</option>
          <option value="5">5 places</option>
          <option value="6">6 places</option>
        </select>
      </div>
      <div class="sm:col-span-2">
        <label class="block text-xs text-stone-400 mb-1">Notes (optional)</label>
        <input type="text" name="notes" placeholder="Any extra details..."
          class="w-full bg-navy-900 border border-navy-600 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div class="sm:col-span-2">
        <button type="submit" class="bg-brand-500 hover:bg-brand-400 text-navy-900 font-bold px-6 py-2.5 rounded-lg transition">Post Game</button>
      </div>
    </form>
  </div>
  <% } %>

  <% if (!openGames || openGames.length === 0) { %>
    <div class="bg-navy-850/60 border border-navy-700/40 rounded-xl px-6 py-14 text-center text-stone-500">
      <p class="text-base mb-1">No open WTA games right now</p>
      <p class="text-sm text-stone-600">Check back soon or ask an admin to post a game.</p>
    </div>
  <% } else { %>
    <div class="space-y-5">
      <% openGames.forEach(g => {
        const _scores = g.scores || [];
        const alreadyJoined = myPlayerId && _scores.some(s => s.player_id === myPlayerId);
        const full = g.max_players && _scores.length >= g.max_players;
      %>
        <div class="bg-navy-800 border border-brand-700/30 rounded-2xl p-5 sm:p-6 shadow-lg">
          <div class="flex flex-wrap justify-between items-start gap-3 mb-4">
            <div class="min-w-0 flex-1">
              <h3 class="text-xl font-bold text-brand-300"><%= g.title || 'WTA Game #' + g.id %></h3>
              <p class="text-xs text-stone-500 mt-1">Posted by <%= g.created_by_name || 'Admin' %></p>
            </div>
            <div class="flex flex-wrap gap-2">
              <% if (alreadyJoined) { %>
                <form method="POST" action="/games/<%= g.id %>/leave">
                  <button type="submit" class="bg-stone-700 hover:bg-red-800 text-stone-300 text-sm px-4 py-1.5 rounded-lg transition">Leave</button>
                </form>
                <span class="bg-green-900/50 text-green-300 text-sm px-3 py-1.5 rounded-lg border border-green-700/50">Joined</span>
              <% } else if (!full) { %>
                <form method="POST" action="/games/<%= g.id %>/join">
                  <button type="submit" class="bg-brand-500 hover:bg-brand-400 text-navy-900 font-bold text-sm px-5 py-1.5 rounded-lg transition">Join Game</button>
                </form>
              <% } else { %>
                <span class="bg-stone-700 text-stone-400 text-sm px-3 py-1.5 rounded-lg">Full</span>
              <% } %>
              <% if (currentUser && currentUser.role === 'admin') { %>
                <form method="POST" action="/games/<%= g.id %>/shuffle" onsubmit="return confirm('Shuffle into random teams of 2?')">
                  <button type="submit" class="bg-purple-700 hover:bg-purple-600 text-white text-sm px-4 py-1.5 rounded-lg transition">Shuffle Teams</button>
                </form>
                <form method="POST" action="/games/<%= g.id %>/start" onsubmit="return confirm('Start this game live?')">
                  <button type="submit" class="bg-green-700 hover:bg-green-600 text-white text-sm px-4 py-1.5 rounded-lg transition">Start Live</button>
                </form>
                <form method="POST" action="/games/<%= g.id %>/cancel-open" onsubmit="return confirm('Cancel this open game?')">
                  <button type="submit" class="bg-stone-700 hover:bg-red-800 text-stone-400 text-sm px-3 py-1.5 rounded-lg transition">Cancel</button>
                </form>
              <% } %>
            </div>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-4 text-sm">
            <% if (g.location) { %><div class="bg-navy-900/60 rounded-lg px-3 py-2 border border-navy-700/50"><p class="text-[10px] uppercase text-stone-500 tracking-wider">Location</p><p class="text-stone-200 font-medium truncate"><%= g.location %></p></div><% } %>
            <% if (g.event_date) { %><div class="bg-navy-900/60 rounded-lg px-3 py-2 border border-navy-700/50"><p class="text-[10px] uppercase text-stone-500 tracking-wider">Date</p><p class="text-stone-200 font-medium"><%= g.event_date %></p></div><% } %>
            <% if (g.event_time) { %><div class="bg-navy-900/60 rounded-lg px-3 py-2 border border-navy-700/50"><p class="text-[10px] uppercase text-stone-500 tracking-wider">Time</p><p class="text-stone-200 font-medium"><%= g.event_time %></p></div><% } %>
            <div class="bg-navy-900/60 rounded-lg px-3 py-2 border border-navy-700/50"><p class="text-[10px] uppercase text-stone-500 tracking-wider">Players</p><p class="text-stone-200 font-medium"><%= _scores.length %><% if (g.max_players) { %> / <%= g.max_players %><% } %></p></div>
            <% if (g.entry_fee) { %><div class="bg-navy-900/60 rounded-lg px-3 py-2 border border-navy-700/50"><p class="text-[10px] uppercase text-stone-500 tracking-wider">Entry Fee</p><p class="text-brand-300 font-medium"><%= g.entry_fee %></p></div><% } %>
            <% if (g.cash_prize) { %><div class="bg-navy-900/60 rounded-lg px-3 py-2 border border-navy-700/50"><p class="text-[10px] uppercase text-stone-500 tracking-wider">Cash Prize</p><p class="text-amber-300 font-medium"><%= g.cash_prize %></p></div><% } %>
            <% if (g.winner_slots) { %><div class="bg-navy-900/60 rounded-lg px-3 py-2 border border-navy-700/50"><p class="text-[10px] uppercase text-stone-500 tracking-wider">Places Paid</p><p class="text-stone-200 font-medium"><%= g.winner_slots %></p></div><% } %>
          </div>
          <% if (g.notes) { %><p class="text-sm text-stone-400 mb-3 italic"><%= g.notes %></p><% } %>
          <div class="mt-2">
            <% if (!_scores.length) { %>
              <span class="text-stone-500 text-sm">No players joined yet</span>
            <% } else { %>
              <div class="flex flex-wrap gap-2">
                <% _scores.forEach(s => { %>
                  <span class="bg-navy-900 text-stone-300 text-sm px-3 py-1 rounded-full border border-navy-600"><%= s.player_name %></span>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
