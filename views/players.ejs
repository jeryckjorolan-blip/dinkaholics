<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-white">Players</h1>
    <p class="text-stone-500 text-sm mt-1"><%= players.length %> active club members</p>
  </div>

  <% if (!players || players.length === 0) { %>
    <div class="bg-navy-850 border border-navy-600/40 rounded-2xl p-12 text-center text-stone-500">
      No players yet. Members appear after admin approval.
    </div>
  <% } else { %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
      <% players.forEach(p => { %>
      <a href="/player/<%= p.id %>" class="bg-navy-850 border border-navy-600/50 rounded-xl p-4 card-hover flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-navy-800 border border-navy-600 flex items-center justify-center text-brand-400 font-bold text-lg shrink-0">
          <%= (p.name || '?').charAt(0).toUpperCase() %>
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-semibold text-stone-100 truncate"><%= p.name %></p>
          <p class="text-xs text-stone-500">
            #<%= p.rank %> · <%= p.skill_level || 'Intermediate' %>
            <% if (p.streak > 0) { %> · 🔥<%= p.streak %><% } %>
          </p>
        </div>
        <div class="text-right shrink-0">
          <p class="text-brand-400 font-bold text-sm tabular-nums"><%= p.points.toLocaleString() %></p>
          <p class="text-[10px] text-stone-500">W<%= p.wins %> L<%= p.losses %></p>
        </div>
      </a>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
